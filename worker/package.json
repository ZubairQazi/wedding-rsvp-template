{
  "name": "wedding-rsvp-template-worker",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute your-wedding-rsvp --local --file=../schema.sql",
    "db:migrate:remote": "wrangler d1 execute your-wedding-rsvp --remote --file=../schema.sql",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^5.5.4",
    "wrangler": "^4.71.0"
  }
}
